# Streamlit Community Cloud → App settings → Secrets 에 붙여 넣기
# 실제 비밀값은 깃에 올리지 마세요.

# 판매자 관리자 비밀번호 (pages/_admin 진입용)
ADMIN_PASSWORD = "여기에_관리자_비밀번호"

# (선택) 인스타 연결 키 — 구매자 화면 붙여넣기가 우선
IG_ACCESS_TOKEN = "여기에_장기_토큰"
IG_USER_ID = "여기에_숫자_ID"

# 구매자 계정 (Cloud에서는 이 방식이 유지에 유리)
# 관리자 화면에서 만든 뒤 아래 형태로 붙여 넣으세요.
# [buyers.cafe_ahn]
# password = "구매자비밀번호"
# note = "카페 ○○"
# enabled = true
