# Streamlit Community Cloud → App settings → Secrets 에 붙여 넣기
# 실제 비밀값은 깃에 올리지 마세요. (.streamlit/secrets.toml 은 gitignore)

# --- 관리자 계정 로그인 (필수) ---
ADMIN_USERNAME = "your_admin_id"
ADMIN_PASSWORD = "your_admin_password"
# (선택) 솔트 해시 권장 — 있으면 평문 ADMIN_PASSWORD 대신 검증에 사용
# ADMIN_PASSWORD_HASH = "sha256$salt$digest"
# ADMIN_PASSWORD_SALT = "salt"  # HASH가 digest만일 때

# (선택) 예전 URL gate 바로가기 — 필수 아님
# ADMIN_GATE = "optional_legacy_gate"

# (선택) 이메일 OTP — 기본 off. 켜려면 ADMIN_OTP_ENABLED=1
# ADMIN_OTP_ENABLED = "1"
# ADMIN_EMAIL = "seller@example.com"
# RESEND_API_KEY = "re_여기에_키"
# RESEND_FROM = "카드뉴스 <onboarding@resend.dev>"
# EMAIL_DEV_MODE = "1"  # 로컬 테스트만 — Cloud/운영 금지

# (선택) 인스타 연결 키 — 구매자 화면 붙여넣기가 우선
IG_ACCESS_TOKEN = "여기에_장기_토큰"
IG_USER_ID = "여기에_숫자_ID"

# 구매자 계정 (Cloud에서는 이 방식이 유지에 유리)
# 관리자 화면에서 만든 뒤 아래 형태로 붙여 넣으세요.
# [buyers.cafe_ahn]
# password = "구매자비밀번호"
# note = "카페 ○○"
# enabled = true
