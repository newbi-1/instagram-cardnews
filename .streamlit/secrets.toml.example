# Streamlit Community Cloud → App settings → Secrets 에 붙여 넣기
# 실제 비밀값은 깃에 올리지 마세요. (.streamlit/secrets.toml 은 gitignore)

# --- 관리자 이중 잠금 ---
# 1) URL gate (?gate=...)  2) ADMIN_EMAIL 로만 OTP (Resend)
ADMIN_GATE = "여기에_긴_랜덤_게이트값"
ADMIN_EMAIL = "seller@example.com"
RESEND_API_KEY = "re_여기에_키"
# (선택) Resend 인증 From — 없으면 onboarding@resend.dev
# RESEND_FROM = "카드뉴스 <onboarding@resend.dev>"
# (선택) ADMIN_EMAIL 미설정 시에만 비밀번호 백업
# ADMIN_PASSWORD = "여기에_관리자_비밀번호"
# (로컬 테스트만 — Cloud/운영에서는 절대 1 금지)
# EMAIL_DEV_MODE = "1"

# (선택) 인스타 연결 키 — 구매자 화면 붙여넣기가 우선
IG_ACCESS_TOKEN = "여기에_장기_토큰"
IG_USER_ID = "여기에_숫자_ID"

# 구매자 계정 (Cloud에서는 이 방식이 유지에 유리)
# 관리자 화면에서 만든 뒤 아래 형태로 붙여 넣으세요.
# [buyers.cafe_ahn]
# password = "구매자비밀번호"
# note = "카페 ○○"
# enabled = true
