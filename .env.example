# Instagram Graph API (공식 Meta API만 사용)
# 없으면 dry-run / 미리보기만 가능
#
# Instagram Login tokens (start with IG…) use https://graph.instagram.com/v21.0
# Facebook Page/System tokens (start with EAA…) use https://graph.facebook.com/v21.0
IG_ACCESS_TOKEN=
IG_USER_ID=

# 선택: 공개 HTTPS base URL (없으면 임시 호스트로 로컬 PNG 업로드)
# IG_IMAGE_BASE_URL=https://cdn.example.com/slides

# 선택: 기본 프로필 폴더명 (clients/ 하위)
DEFAULT_PROFILE=demo

# 판매자 관리자 — 아이디/비밀번호 (Secrets 권장; .env 는 로컬만)
ADMIN_USERNAME=your_admin_id
# 권장: 솔트 해시 (평문보다 안전)
ADMIN_PASSWORD_HASH=sha256$salt$digest
# (덜 권장) 평문 폴백 — 해시 쓰기 어려울 때만
# ADMIN_PASSWORD=your_admin_password
# ADMIN_PASSWORD_SALT=salt
# ADMIN_GATE=optional-legacy-gate
# ADMIN_OTP_ENABLED=1
# ADMIN_EMAIL=seller@example.com
# RESEND_API_KEY=
# EMAIL_DEV_MODE=1                 # 로컬만 — OTP UI 표시 (Cloud 금지)
