# Secrets
.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Streamlit
.streamlit/secrets.toml

# Client outputs & local data (keep profile.json structure via demo sample)
clients/*/outputs/*.png
clients/*/outputs/*.jpg
clients/*/outputs/*.jpeg
!clients/demo/outputs/.gitkeep

# Free photo cache (downloaded at runtime)
assets/cache/*
!assets/cache/.gitkeep

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log

# Buyer accounts (local persistence — never commit passwords)
data/buyers.json
data/buyers.json.tmp
data/.write_probe

# Buyer settings & schedules (local / Cloud ephemeral — never commit secrets)
data/buyer_settings.json
data/buyer_settings.json.tmp
data/schedules.json
data/schedules.json.tmp
